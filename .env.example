# Public browser configuration for Pilgrixaistudio
VITE_APP_NAME=Pilgrixaistudio
VITE_APP_VERSION=0.1.0
VITE_API_BASE_URL=http://localhost:3000
VITE_API_MODE=local-dev
VITE_AUTH_PROVIDER=none
VITE_AUTH_SESSION_STORAGE_KEY=pilgrixaistudio-session
VITE_AI_PROVIDER=none
VITE_AI_API_URL=
VITE_AI_MODEL=not-configured
VITE_STORAGE_PROVIDER=local-dev
VITE_STORAGE_BUCKET=pilgrixaistudio-media
VITE_MAX_FILE_SIZE=104857600
VITE_JOB_API_URL=
VITE_EXPORT_API_URL=
VITE_MEDIA_API_URL=

# Optional public provider values for browser-safe integrations
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server-side only. Never expose these in frontend code.
INFOBIP_API_KEY=
INFOBIP_BASE_URL=https://api.infobip.com
INFOBIP_SENDER=

# Server-side Supabase JWT verification
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# IMPORTANT: never place real secrets or private tokens in source control.
# Private credentials must stay on a server-side API gateway or backend service.
# Examples that must remain out of the browser bundle and Git history:
# OPENAI_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# FFmpeg or media-processing service credentials must stay server-side.
