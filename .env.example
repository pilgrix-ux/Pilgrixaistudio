# Public client configuration for the browser app
VITE_APP_NAME=Pilgrixaistudio
VITE_APP_VERSION=0.1.0
VITE_API_BASE_URL=http://localhost:3000
VITE_API_MODE=local-dev
VITE_AUTH_PROVIDER=none
VITE_AI_PROVIDER=none
VITE_STORAGE_PROVIDER=local-dev

# Optional public app settings
VITE_STORAGE_BUCKET=pilgrixaistudio-media
VITE_MAX_FILE_SIZE=104857600

# Optional future integration placeholders (not enabled by default)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_AI_API_URL=
# VITE_AI_MODEL=

# Server-only secrets must never be stored in VITE_* variables.
# Example values for a real backend later:
# OPENAI_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# FFmpeg and media processing backends remain intentionally unconfigured here.
